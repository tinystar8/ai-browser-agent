# Local Ollama. Do not point this at api.openai.com.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3.6:35b

# Chromium window. Set HEADLESS=true on a machine without a display.
HEADLESS=false
BROWSER_PROFILE=./browser-profile

# API bind address. Keep this on localhost; the profile can hold your logins.
HOST=127.0.0.1
PORT=8000

DATABASE_PATH=./database/agent.db
SCREENSHOTS_DIR=./screenshots
LOGS_DIR=./logs

# A 35B local model is slow. Raise LLM_TIMEOUT if steps expire.
MAX_STEPS=25
LLM_TIMEOUT=500
STEP_TIMEOUT=500
USE_VISION=false
USE_THINKING=false
SHELL_ENABLED=true

ANONYMIZED_TELEMETRY=false
